<?xml version="1.0" encoding="UTF-8"?>

<!--
  ═══════════════════════════════════════════════════════════
  GoBlox 🐿️ — Motion Block: Go To X
  ═══════════════════════════════════════════════════════════
  File:      blocks/motion/gotox.xml
  Category:  Motion
  Renderer:  WebGL
  Author:    MrMichaelChapoDel

  Description:
    Moves the Hamster sprite to an exact X coordinate,
    keeping its Y position unchanged.

  Trust Rule:
    <mode> is REQUIRED. If <mode> is missing or invalid,
    GoBlox will NOT load this block.
  ═══════════════════════════════════════════════════════════
-->

<block type="motion">

  <!-- ─────────────────────────────────────────────
       1. DISPLAY
       ───────────────────────────────────────────── -->
  <text>Go to x: 0</text>


  <!-- ─────────────────────────────────────────────
       2. MODE  (REQUIRED — TRUST ANCHOR 🔍)
       ───────────────────────────────────────────── -->
  <mode chip="web" define=".motion"></mode>


  <!-- ─────────────────────────────────────────────
       3. BEHAVIOR
       Jump straight to an X coordinate.
       ───────────────────────────────────────────── -->
  <behavior>

    <!-- The action to perform -->
    <action>move</action>

    <!-- Which sprite this affects -->
    <target>hamster</target>

    <!-- The X coordinate to jump to -->
    <steps>0</steps>

    <!-- Which rendering backend handles it -->
    <renderer>webgl</renderer>

    <!-- Moving along the X axis -->
    <axis>x</axis>

  </behavior>


  <!-- ─────────────────────────────────────────────
       4. PARAMETERS
       ───────────────────────────────────────────── -->
  <params>

    <!-- Target X coordinate -->
    <param
      name="x"
      type="number"
      value="0"
      min="-1000"
      max="1000"
    />

  </params>

</block>