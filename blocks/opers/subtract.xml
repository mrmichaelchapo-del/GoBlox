<?xml version="1.0" encoding="UTF-8"?>

<!--
  ═══════════════════════════════════════════════════════════
  GoBlox 🐿️ — Operators Block: Subtract
  ═══════════════════════════════════════════════════════════
  File:      blocks/opers/subtract.xml
  Category:  Operators
  Renderer:  WebGL
  Author:    MrMichaelChapoDel

  Description:
    Subtracts the second number from the first: () - ().
    Returns the difference as a number. Useful for
    computing gaps, offsets, and remaining amounts.

  Trust Rule:
    <mode> is REQUIRED. If <mode> is missing or invalid,
    GoBlox will NOT load this block.
  ═══════════════════════════════════════════════════════════
-->

<block type="opers">

  <!-- ─────────────────────────────────────────────
       1. DISPLAY
       ───────────────────────────────────────────── -->
  <text>() - ()</text>


  <!-- ─────────────────────────────────────────────
       2. MODE  (REQUIRED — TRUST ANCHOR 🔍)
       Defines the block's category and runtime target.
       Missing or invalid <mode> = block is NOT loaded.
       ───────────────────────────────────────────── -->
  <mode chip="web" define=".opers"></mode>


  <!-- ─────────────────────────────────────────────
       3. BEHAVIOR
       Subtract b from a.
       ───────────────────────────────────────────── -->
  <behavior>

    <!-- The action to perform -->
    <action>subtract</action>

    <!-- Which sprite this affects -->
    <target>hamster</target>

    <!-- Steps (unused for subtract, required by schema) -->
    <steps>1</steps>

    <!-- Which rendering backend handles it -->
    <renderer>webgl</renderer>

    <!-- Axis (unused for subtract, kept for validation) -->
    <axis>x</axis>

  </behavior>


  <!-- ─────────────────────────────────────────────
       4. PARAMETERS
       The two numbers to subtract.
       ───────────────────────────────────────────── -->
  <params>

    <!-- First operand (minuend) -->
    <param
      name="a"
      type="number"
      value="0"
    />

    <!-- Second operand (subtrahend) -->
    <param
      name="b"
      type="number"
      value="0"
    />

  </params>

</block>